                  "fields": [
                    {
                      "name": "pessoa",
                      "expression": "`pessoa`"
                    },
                    {
                      "name": "sum(custo_ocioso)",
                      "expression": "SUM(`custo_ocioso`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
